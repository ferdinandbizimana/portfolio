# Single entry point: the browser talks to one origin.
# /api/* goes to FastAPI, everything else to Next.js.
# SITE_ADDRESS is ":8080" locally; in production it is the domain name,
# and Caddy then obtains and renews the HTTPS certificate automatically.
{$SITE_ADDRESS::8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Browsers keep to HTTPS for a year once they have seen the site over HTTPS
		# (ignored on plain-HTTP local addresses).
		Strict-Transport-Security "max-age=31536000"
		# Only this site's own scripts, styles, images and API. Next.js needs
		# inline scripts and the charts set inline styles. "?" keeps a stricter
		# policy sent by the API (interactive dashboards are sandboxed).
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
