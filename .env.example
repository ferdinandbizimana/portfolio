# Copy to .env and fill in. Never commit .env.

# development | test | production
ENVIRONMENT=development

# On the server only: use the production settings and start the backups.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PROFILES=backup
LOG_LEVEL=INFO

# PostgreSQL (used by docker-compose to create the database and build DATABASE_URL)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# First admin account: created when the backend starts and the database has no
# account yet (password at least 12 characters). Later changes: use the
# set-password command, not these lines.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Address Caddy serves. Locally ":8080"; in production your domain, e.g. "example.com".
SITE_ADDRESS=:8080

# Send the login cookie over HTTPS only. Keep false for http://localhost, true in production.
COOKIE_SECURE=false

# Public address of the site (sitemap and link previews). Your domain in production.
SITE_URL=http://localhost:8080

# Contact form e-mail. Messages are sent to CONTACT_TO_EMAIL through this SMTP account.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
# SMTP_USERNAME=your Gmail address, SMTP_PASSWORD=an app password (not your normal one).
# For local testing without sending real e-mail: COMPOSE_PROFILES=dev-mail,
# SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=none; read mail at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_TO_EMAIL=

# Scheduled runs: an e-mail when a run finishes goes to NOTIFY_EMAIL
# (empty: CONTACT_TO_EMAIL), through the SMTP account above.
NOTIFY_EMAIL=

# Spot-check variance follow-up: every e-mail to the responsible staff is also
# sent (BCC) to VARIANCE_BCC. The list of open variances goes out on working days
# at VARIANCE_REMINDER_TIME; a variance turns red after VARIANCE_OVERDUE_DAYS.
# Names in the bin list that are units, not people (their bins are left out):
VARIANCE_BCC=
VARIANCE_REMINDER_TIME=07:30
VARIANCE_OVERDUE_DAYS=2
VARIANCE_UNIT_NAMES=RECEIVING, PICKING

# Monthly expiry follow-up: on the last day of each month from EXPIRY_MAIL_TIME the
# latest expiry monitoring run is e-mailed (Excel attached, secure link to justify
# expired items) to EXPIRY_MAIL_TO, copied to EXPIRY_MAIL_CC (comma-separated) and
# EXPIRY_MAIL_BCC. Nothing is sent while EXPIRY_MAIL_TO is empty.
EXPIRY_MAIL_TO=
EXPIRY_MAIL_CC=
EXPIRY_MAIL_BCC=
EXPIRY_MAIL_TIME=08:00

# Time zone of the schedules ("every day at 06:00").
TIMEZONE=Africa/Kigali

# Shared folder where SAP exports are dropped. The app only reads it.
# Path on the server (or this computer); default ./local-data/inbox.
INBOX_HOST_DIR=
# A file is taken once it has not changed for this many seconds.
INBOX_SETTLE_SECONDS=60
# How often the folder and the schedules are checked.
SCHEDULER_INTERVAL_SECONDS=60

# Backups (restic, encrypted). RESTIC_REPOSITORY examples:
#   s3:https://s3.eu-central-003.backblazeb2.com/your-bucket   (Backblaze B2, S3 keys below)
#   s3:s3.amazonaws.com/your-bucket                            (Amazon S3)
#   /backups  (a folder: BACKUP_LOCAL_DIR on this machine; copy it off the server!)
# Keep RESTIC_PASSWORD somewhere safe outside the server: without it the
# backups cannot be read.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_TIME=02:30
BACKUP_LOCAL_DIR=
# Optional: a URL called after every successful backup (e.g. healthchecks.io),
# which alerts you when backups stop.
BACKUP_PING_URL=

# Only needed when running the backend outside Docker:
# DATABASE_URL=postgresql+psycopg://portfolio:<password>@localhost:5432/portfolio
# REDIS_URL=redis://localhost:6379/0
# STORAGE_DIR=./local-data/storage
