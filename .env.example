# Copy to .env and fill in. Never commit .env.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (used by docker-compose to create the database and build DATABASE_URL)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Address Caddy serves. Locally ":8080"; in production your domain, e.g. "example.com".
SITE_ADDRESS=:8080

# Send the login cookie over HTTPS only. Keep false for http://localhost, true in production.
COOKIE_SECURE=false

# Only needed when running the backend outside Docker:
# DATABASE_URL=postgresql+psycopg://portfolio:<password>@localhost:5432/portfolio
# REDIS_URL=redis://localhost:6379/0
# STORAGE_DIR=./local-data/storage
